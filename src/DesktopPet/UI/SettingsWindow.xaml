<Window x:Class="DesktopPet.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelPaws Settings"
        Width="400" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FF8855BB"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Head">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="🐾 PixelPaws" FontSize="18" FontWeight="Bold" Margin="4,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="Done" Width="80" Click="CloseButton_Click"/>
        </StackPanel>

        <TabControl>
            <!-- ─────────────── Behaviour ─────────────── -->
            <TabItem Header="Behaviour">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Speed" Margin="0,0,0,2"/>
                        <Slider x:Name="SpeedSlider" Minimum="0.3" Maximum="2.5" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Margin="0,0,0,12"/>

                        <CheckBox x:Name="WindowWalkingBox" Content="Walk on top of windows"/>
                        <CheckBox x:Name="CursorChaseBox"   Content="Chase the mouse cursor"/>
                        <CheckBox x:Name="SleepBox"         Content="Take naps"/>
                        <CheckBox x:Name="ScrollPlayBox"    Content="Unroll toilet paper when I scroll 🧻"/>
                        <CheckBox x:Name="MoodsBox"         Content="Lifelike moods (naps at night) 🌙"/>
                        <CheckBox x:Name="SystemReactionsBox" Content="React to my computer 💻"/>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="🤫 Quiet mode" Style="{StaticResource Head}"/>
                        <CheckBox x:Name="QuietModeBox"  Content="Settle down when I'm presenting"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                   Text="Stops zoomies, hunting and chatter while you present, screen-share, game full-screen, or have focus assist on."/>
                        <CheckBox x:Name="HidePresentBox" Content="Hide the cat completely at those times" Margin="22,0,0,4"/>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="🧘 Stretch reminder" Style="{StaticResource Head}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Remind me every" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="StretchIntervalBox" Width="120" VerticalAlignment="Center">
                                <ComboBoxItem Content="Off"        Tag="0"/>
                                <ComboBoxItem Content="15 minutes" Tag="15"/>
                                <ComboBoxItem Content="30 minutes" Tag="30"/>
                                <ComboBoxItem Content="45 minutes" Tag="45"/>
                                <ComboBoxItem Content="60 minutes" Tag="60"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="Your cat will stretch too 🐱" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────────── Appearance ─────────────── -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Size" Margin="0,0,0,2"/>
                        <ComboBox x:Name="SizeBox" Width="150" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <ComboBoxItem Content="Small"  Tag="0.75"/>
                            <ComboBoxItem Content="Medium" Tag="1.0"/>
                            <ComboBoxItem Content="Large"  Tag="1.3"/>
                            <ComboBoxItem Content="Huge"   Tag="1.6"/>
                        </ComboBox>

                        <TextBlock Text="Cat color" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CatColorBox" Width="150" HorizontalAlignment="Left" Margin="0,0,0,2">
                            <ComboBoxItem Content="Gray"         Tag="cat"/>
                            <ComboBoxItem Content="Orange"       Tag="cat-orange"/>
                            <ComboBoxItem Content="Silver tabby" Tag="cat-silver"/>
                            <ComboBoxItem Content="Cream"        Tag="cat-cream"/>
                            <ComboBoxItem Content="Chocolate"    Tag="cat-chocolate"/>
                            <ComboBoxItem Content="Blue"         Tag="cat-blue"/>
                            <ComboBoxItem Content="Janet"        Tag="cat-janet"/>
                        </ComboBox>
                        <TextBlock x:Name="ColorRestartNote" Text="Restart PixelPaws to apply the new color 🐱"
                                   Style="{StaticResource Hint}" Margin="0,0,0,14" Visibility="Collapsed"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────────── AI ─────────────── -->
            <TabItem Header="AI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="AiEnableBox" Content="Let me chat with the cat"/>

                        <TextBlock Text="Brain" Margin="0,10,0,2"/>
                        <ComboBox x:Name="AiProviderBox" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Google Gemini (free, cloud)" Tag="gemini"/>
                            <ComboBoxItem Content="Ollama (local &amp; private)" Tag="ollama"/>
                        </ComboBox>

                        <!-- Gemini -->
                        <StackPanel x:Name="GeminiPanel">
                            <TextBlock Text="Free Gemini API key" Margin="0,10,0,2"/>
                            <PasswordBox x:Name="AiKeyBox" Margin="0,0,0,2"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Stored only on this PC — never uploaded or shared. Get a free key at aistudio.google.com."/>
                            <TextBlock Text="Model" Margin="0,0,0,2"/>
                            <TextBox x:Name="AiModelBox" Margin="0,0,0,2"/>
                        </StackPanel>

                        <!-- Ollama -->
                        <StackPanel x:Name="OllamaPanel" Visibility="Collapsed">
                            <TextBlock Text="Server URL" Margin="0,10,0,2"/>
                            <TextBox x:Name="OllamaUrlBox" Margin="0,0,0,6"/>
                            <TextBlock Text="Model" Margin="0,0,0,2"/>
                            <TextBox x:Name="OllamaModelBox" Margin="0,0,0,2"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Runs entirely on your machine — no key, no quota, works offline. Install from ollama.com, then e.g. `ollama pull llama3.2`."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="TestButton" Content="Test connection" Width="130" Click="TestButton_Click"/>
                            <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Style="{StaticResource Hint}" MaxWidth="200"/>
                        </StackPanel>

                        <Separator Margin="0,12"/>

                        <CheckBox x:Name="AiToolsBox"     Content="Allow cute tools (time, weather, stats)"/>
                        <CheckBox x:Name="AiChatterBox"   Content="Let the cat speak up on its own 💬"/>
                        <CheckBox x:Name="AiStreamingBox" Content="Type replies out as they arrive ⌨️"/>
                        <CheckBox x:Name="AiHotkeyBox"    Content="Open chat with a keyboard shortcut"/>
                        <StackPanel Orientation="Horizontal" Margin="22,0,0,4">
                            <TextBlock Text="Shortcut:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="HotkeyCaptureBox" Width="150" IsReadOnly="True"
                                     PreviewKeyDown="HotkeyCaptureBox_PreviewKeyDown"
                                     ToolTip="Click here, then press your shortcut (needs a modifier like Ctrl or Alt)"/>
                        </StackPanel>

                        <TextBlock Text="Cat personality" Margin="0,10,0,2"/>
                        <TextBox x:Name="AiPersonaBox" TextWrapping="Wrap" AcceptsReturn="True" Height="54"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                        <CheckBox x:Name="AiMemoryBox" Content="Remember our chats between sessions 🧠"/>
                        <Button x:Name="ForgetButton" Content="Forget everything 🧹" Width="160"
                                HorizontalAlignment="Left" Margin="22,4,0,4" Click="ForgetButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────────── System ─────────────── -->
            <TabItem Header="System">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="AutostartBox"  Content="Start with Windows"/>
                        <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically 🔄"/>
                        <CheckBox x:Name="RememberStateBox" Content="Remember where the cat was and how it felt"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                   Text="The cat wakes up where you left it, still sleepy if it was sleepy."/>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="🩺 Diagnostics" Style="{StaticResource Head}"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LogsButton" Content="Open log folder" Width="130" Click="LogsButton_Click"/>
                            <Button x:Name="UpdateCheckButton" Content="Check now" Width="100" Margin="8,0,0,0"
                                    Click="UpdateCheckButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdateResult" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
